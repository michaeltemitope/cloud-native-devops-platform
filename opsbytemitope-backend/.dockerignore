# Git
.git
.gitignore

# Maven build output (copied explicitly in Dockerfile)
target/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath

# OS noise
.DS_Store
Thumbs.db

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Docs and test configs that aren't needed in the image
README.md
CHANGELOG.md
docs/
checkstyle/

# Test sources
src/test/

# Docker-specific
Dockerfile
.dockerignore
docker-compose*.yml
