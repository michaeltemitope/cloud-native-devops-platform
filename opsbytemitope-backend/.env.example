# =============================================================
# OpsByTemitope Backend – Environment Variables
# Copy this file to .env and fill in real values for local dev.
# NEVER commit .env to version control.
# =============================================================

# ── Spring Profile ────────────────────────────────────────────
# Options: dev | prod
# Default: dev
SPRING_PROFILES_ACTIVE=dev

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8080

# URL used in Swagger UI "Servers" dropdown and CORS origin checks
APP_BASE_URL=http://localhost:8080

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opsbytemitope_dev
DB_USERNAME=opsbytemitope
DB_PASSWORD=change_me_local

# Connection pool (optional, defaults apply)
# DB_POOL_SIZE=10
# DB_POOL_MIN_IDLE=2

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank if your local Redis has no password
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters). Use a strong random value.
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-very-long-random-256-bit-secret-key-before-use
# Token lifetime in milliseconds. Default 86400000 = 24 hours.
JWT_EXPIRATION_MS=86400000

# ── Logging ───────────────────────────────────────────────────
# Only used in prod profile
# LOG_FILE=/var/log/opsbytemitope/app.log
