# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
#
# Optional ENV vars:
# ------------------
#   JAVA_HOME - location of a JDK home dir, used when 'java' command not found
#   MVNW_REPOURL - repo url base for downloading maven distribution
#   MVNW_USERNAME/MVNW_PASSWORD - user and password for downloading maven
#   MVNW_VERBOSE - true: enable verbose log; others: silence the output
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != true ] || set -x

# OS specific support.
native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

# set JAVACMD and JAVA_HOME
if [ -n "${JAVA_HOME-}" ]; then
  if [ -x "$JAVA_HOME/jre/sh/java" ]; then
    # IBM's JDK on AIX uses strange locations for the executables
    JAVACMD="$JAVA_HOME/jre/sh/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
  if [ ! -x "$JAVACMD" ]; then
    die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME
Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
  fi
else
  JAVACMD="$(
    'set' +e
    'unset' -f command 2>/dev/null
    'command' -v java
  )" || :
  if [ ! -x "${JAVACMD-}" ]; then
    die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.
Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
  fi
fi

# In Cygwin/MinGW, paths may need conversion
if command -v cygpath >/dev/null 2>&1; then
  APP_HOME="$(cygpath --path --unix "$APP_HOME")"
fi

# Detect the application home directory
APP_HOME="${0%/*}/"
if [ ! -f "$APP_HOME/pom.xml" ]; then
  APP_HOME="$(pwd)"
fi
APP_HOME="$(cd "$APP_HOME" && pwd)"

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$APP_HOME}"

# Download wrapper jar if missing
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep 'distributionUrl' "$WRAPPER_PROPERTIES" | sed 's/.*=//')
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  if command -v wget > /dev/null 2>&1; then
    DOWNLOAD_COMMAND="wget -q -O"
  elif command -v curl > /dev/null 2>&1; then
    DOWNLOAD_COMMAND="curl -f -s -o"
  fi

  if [ -n "${DOWNLOAD_COMMAND-}" ]; then
    WRAPPER_URL=$(grep 'wrapperUrl' "$WRAPPER_PROPERTIES" 2>/dev/null | sed 's/.*=//') || true
    if [ -n "${WRAPPER_URL-}" ]; then
      mkdir -p "$(dirname "$WRAPPER_JAR")"
      $DOWNLOAD_COMMAND "$WRAPPER_JAR" "$WRAPPER_URL" 2>/dev/null || {
        rm -f "$WRAPPER_JAR"
      }
    fi
  fi
fi

MAVEN_OPTS="${MAVEN_OPTS:-} -Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR"

if [ -f "$WRAPPER_JAR" ]; then
  exec "$JAVACMD" $MAVEN_OPTS \
    -classpath "$WRAPPER_JAR" \
    org.apache.maven.wrapper.MavenWrapperMain \
    -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
    "$@"
else
  # Wrapper jar could not be downloaded; fall back to system Maven
  if command -v mvn > /dev/null 2>&1; then
    exec mvn "$@"
  else
    echo "ERROR: Neither the Maven wrapper jar ($WRAPPER_JAR) nor system 'mvn' could be found." >&2
    echo "Please install Maven 3.9+ or run: mvn wrapper:wrapper" >&2
    exit 1
  fi
fi
